# Bu dosya bir ŞABLONDUR. Kopyalayıp adını ".env" yapın ve değerleri kendinize göre doldurun.
#   Windows (PowerShell):  Copy-Item .env.example .env
# ".env" dosyası .gitignore ile gizlidir; GitHub'a ASLA gönderilmemelidir.

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=crkys
DB_USER=postgres
DB_PASSWORD=BURAYA_KENDI_VERITABANI_SIFRENIZI_YAZIN

# --- JWT (oturum anahtarı) ---
# En az 32 karakterlik rastgele bir metin kullanın. Üretmek için:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=BURAYA_UZUN_RASTGELE_BIR_ANAHTAR_YAZIN
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# --- İsteğe bağlı ---
# İstemcinin bağlanacağı sunucu adresi (varsayılan: http://127.0.0.1:8000)
# TKYS_API_URL=http://127.0.0.1:8000
# Yedekleme için pg_dump'ın tam yolu (PATH'te değilse)
# PG_DUMP_PATH=C:\Program Files\PostgreSQL\16\bin\pg_dump.exe